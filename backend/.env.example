# DATABASE CONFIGURATION
# Copy this file to .env and update with your actual database credentials

# MySQL Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=team_collab_db

# Application Settings
NODE_ENV=development
PORT=3000

# Security Settings (for future use)
JWT_SECRET=your_jwt_secret_here
BCRYPT_ROUNDS=10

# File Upload Settings (for future use)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Email Settings (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Redis Settings (for future use)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Production Database (for production environment)
PROD_DB_HOST=your_production_host
PROD_DB_PORT=3306
PROD_DB_USER=your_prod_user
PROD_DB_PASSWORD=your_prod_password
PROD_DB_NAME=team_collab_prod